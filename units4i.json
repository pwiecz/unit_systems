{
    "si_units": ["l", "m", "t", "I"],
    "units": [
        {"name": "l", "exponents": [1, 0, 0, 0], "comment": "length"},
        {"name": "m", "exponents": [0, 1, 0, 0], "comment": "mass"},
        {"name": "t", "exponents": [0, 0, 1, 0], "comment": "time"},
        {"name": "I", "exponents": [0, 0, 0, 1], "comment": "current"},
        {"name": "p", "exponents": [1, 1, -1, 0], "comment": "momentum"},
        {"name": "v", "exponents": [1, 0, -1, 0], "comment": "speed"},
        {"name": "h", "exponents": [2, 1, -1, 0], "comment": "angular momentum (Planck constant)"},
        {"name": "G", "exponents": [3, -1, -2, 0], "comment": "gravitational constant"},
        {"name": "q", "exponents": [0, 0, 1, 1], "comment": "electric charge"},
        {"name": "epsilon", "exponents": [-3, -1, 4, 2], "comment": "vacuum permittivity"},
        {"name": "mu", "exponents": [1, 1, -2, -2], "comment": "magnetic permeability"},
        {"name": "Z", "exponents": [2, 1, -3, -2], "comment": "electrical impedance"}
    ]
}
